local A = (function()
	local TweenService = game:GetService("TweenService")
	local UIS = game:GetService("UserInputService")
	local CoreGui = game:GetService("CoreGui")

	local Lib = { Options = {} }

	local Theme = {
		Window = Color3.fromRGB(12, 12, 14),
		Side = Color3.fromRGB(18, 18, 20),
		Content = Color3.fromRGB(6, 6, 7),
		Row = Color3.fromRGB(24, 24, 26),
		RowHover = Color3.fromRGB(32, 32, 35),
		Accent = Color3.fromRGB(104, 196, 232),
		Title = Color3.fromRGB(86, 168, 232),
		Text = Color3.fromRGB(222, 222, 226),
		Sub = Color3.fromRGB(140, 140, 148),
		Off = Color3.fromRGB(44, 44, 48),
		Close = Color3.fromRGB(214, 62, 62),
		Font = Enum.Font.Gotham,
		FontB = Enum.Font.GothamBold,
	}

	---------------------------------------------------------------- helpers
	local function new(class, props, parent)
		local obj = Instance.new(class)
		for k, v in pairs(props or {}) do
			obj[k] = v
		end
		if parent then
			obj.Parent = parent
		end
		return obj
	end

	local function corner(parent, r)
		return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }, parent)
	end

	local function tween(obj, props, t)
		TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
	end

	local function label(parent, text, size, color, font, align)
		return new("TextLabel", {
			BackgroundTransparency = 1,
			Text = text,
			TextSize = size or 14,
			TextColor3 = color or Theme.Text,
			Font = font or Theme.Font,
			TextXAlignment = align or Enum.TextXAlignment.Left,
		}, parent)
	end

	local function isSelf(a)
		return type(a) == "table" and a.__k == true
	end

	-- keo slider dung chung (1 ket noi toan cuc)
	local dragFn, dragEnd
	UIS.InputChanged:Connect(function(input)
		if
			dragFn
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			dragFn(input)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if
			dragFn
			and (
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			local e = dragEnd
			dragFn, dragEnd = nil, nil
			if e then
				e()
			end
		end
	end)

	local function sliderWidget(parent, title, min, max, def, decimals, onChange)
		local value = min
		local l = label(parent, title, 14, Theme.Text)
		l.Position = UDim2.new(0, 16, 0, 8)
		l.Size = UDim2.new(1, -100, 0, 20)
		l.TextTruncate = Enum.TextTruncate.AtEnd
		local v = label(parent, "", 12, Theme.Sub, Theme.Font, Enum.TextXAlignment.Right)
		v.Position = UDim2.new(1, -86, 0, 8)
		v.Size = UDim2.new(0, 70, 0, 20)

		local hit = new("TextButton", {
			Position = UDim2.new(0, 16, 0, 34),
			Size = UDim2.new(1, -32, 0, 20),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
		}, parent)
		local track = new("Frame", {
			Position = UDim2.new(0, 0, 0.5, -2),
			Size = UDim2.new(1, 0, 0, 4),
			BackgroundColor3 = Theme.Off,
			BorderSizePixel = 0,
		}, hit)
		corner(track, 2)
		local fill = new("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
		}, track)
		corner(fill, 2)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 12, 0, 12),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, fill)
		corner(knob, 6)

		local last = 0
		local function setValue(x, fire, final)
			if decimals then
				x = math.floor(x * 10 + 0.5) / 10
			else
				x = math.floor(x + 0.5)
			end
			x = math.clamp(x, min, max)
			value = x
			v.Text = decimals and string.format("%.1f", x) or tostring(x)
			fill.Size = UDim2.new((x - min) / math.max(max - min, 1e-9), 0, 1, 0)
			if fire and onChange then
				if final or os.clock() - last > 0.15 then
					last = os.clock()
					task.spawn(onChange, x)
				end
			end
		end
		local function fromInput(input)
			local a = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
			setValue(min + math.clamp(a, 0, 1) * (max - min), true, false)
		end
		hit.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragFn = fromInput
				dragEnd = function()
					setValue(value, true, true)
				end
				fromInput(input)
			end
		end)
		setValue(def, false, false)
		return {
			Set = function(x)
				setValue(x, true, true)
			end,
			Get = function()
				return value
			end,
		}
	end

	---------------------------------------------------------------- thong bao
	local notifyHolder
	local function Notify(title, text, duration)
		task.spawn(function()
			if not notifyHolder or not notifyHolder.Parent then
				local old = CoreGui:FindFirstChild("KhangNotifyGui")
				if old then
					old:Destroy()
				end
				local gui = new("ScreenGui", { Name = "KhangNotifyGui", ResetOnSpawn = false, DisplayOrder = 60 }, CoreGui)
				notifyHolder = new("Frame", {
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -16, 1, -16),
					Size = UDim2.new(0, 260, 1, -32),
				}, gui)
				new("UIListLayout", {
					Padding = UDim.new(0, 8),
					VerticalAlignment = Enum.VerticalAlignment.Bottom,
					HorizontalAlignment = Enum.HorizontalAlignment.Right,
					SortOrder = Enum.SortOrder.LayoutOrder,
				}, notifyHolder)
			end
			local card = new("Frame", {
				BackgroundColor3 = Theme.Window,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 56),
			}, notifyHolder)
			corner(card, 8)
			local bar = new("Frame", {
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 3, 1, -16),
				Position = UDim2.new(0, 8, 0, 8),
			}, card)
			corner(bar, 2)
			local t1 = label(card, tostring(title), 14, Theme.Title, Theme.FontB)
			t1.Position = UDim2.new(0, 20, 0, 8)
			t1.Size = UDim2.new(1, -28, 0, 18)
			t1.TextTransparency = 1
			local t2 = label(card, tostring(text), 13, Theme.Text)
			t2.Position = UDim2.new(0, 20, 0, 28)
			t2.Size = UDim2.new(1, -28, 0, 18)
			t2.TextTransparency = 1
			t2.TextTruncate = Enum.TextTruncate.AtEnd
			tween(card, { BackgroundTransparency = 0 }, 0.3)
			tween(bar, { BackgroundTransparency = 0 }, 0.3)
			tween(t1, { TextTransparency = 0 }, 0.3)
			tween(t2, { TextTransparency = 0 }, 0.3)
			task.wait(duration or 3)
			tween(card, { BackgroundTransparency = 1 }, 0.3)
			tween(bar, { BackgroundTransparency = 1 }, 0.3)
			tween(t1, { TextTransparency = 1 }, 0.3)
			tween(t2, { TextTransparency = 1 }, 0.3)
			task.wait(0.35)
			card:Destroy()
		end)
	end

	function Lib.CreateNoti(cfg)
		cfg = cfg or {}
		Notify(cfg.Title or "Khang Hub", cfg.Desc or "", cfg.ShowTime or 3)
	end

	---------------------------------------------------------------- cua so chinh
	function Lib.CreateMain(mcfg)
		mcfg = mcfg or {}
		local old = CoreGui:FindFirstChild("KhangHub")
		if old then
			old:Destroy()
		end

		local gui = new("ScreenGui", {
			Name = "KhangHub",
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			DisplayOrder = 50,
		}, CoreGui)

		local main = new("Frame", {
			Name = "Main",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 675, 0, 475),
			BackgroundColor3 = Theme.Window,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, gui)
		corner(main, 8)

		local scale = new("UIScale", {}, main)
		local function fit()
			local cam = workspace.CurrentCamera
			if not cam then
				return
			end
			local vp = cam.ViewportSize
			scale.Scale = math.clamp(math.min(vp.X / 720, vp.Y / 520), 0.5, 1)
		end
		fit()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
		end

		-- thanh tieu de
		local bar = new("Frame", { Name = "TitleBar", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48) }, main)
		local ttl = label(bar, "Khang Hub", 17, Theme.Title, Theme.FontB)
		ttl.Position = UDim2.new(0, 18, 0, 0)
		ttl.Size = UDim2.new(0, 120, 1, 0)
		local subTitle = label(bar, tostring(mcfg.Desc or ""):gsub("^%s*%-?%s*", ""), 13, Theme.Sub)
		subTitle.Position = UDim2.new(0, 124, 0, 2)
		subTitle.Size = UDim2.new(1, -200, 1, 0)

		local close = new("TextButton", {
			Name = "Close",
			Position = UDim2.new(1, -40, 0, 8),
			Size = UDim2.new(0, 32, 0, 32),
			BackgroundColor3 = Theme.Close,
			AutoButtonColor = false,
			Text = "x",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 16,
			Font = Theme.FontB,
		}, bar)
		corner(close, 6)
		close.MouseEnter:Connect(function()
			tween(close, { BackgroundColor3 = Color3.fromRGB(235, 82, 82) })
		end)
		close.MouseLeave:Connect(function()
			tween(close, { BackgroundColor3 = Theme.Close })
		end)
		close.MouseButton1Click:Connect(function()
			gui.Enabled = false
		end)

		do -- keo cua so
			local dragging, dragStart, startPos
			bar.InputBegan:Connect(function(input)
				if
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					dragging = true
					dragStart = input.Position
					startPos = main.Position
					input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							dragging = false
						end
					end)
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if
					dragging
					and (
						input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch
					)
				then
					local d = input.Position - dragStart
					main.Position = UDim2.new(
						startPos.X.Scale,
						startPos.X.Offset + d.X,
						startPos.Y.Scale,
						startPos.Y.Offset + d.Y
					)
				end
			end)
		end

		-- sidebar (cuon duoc vi script co nhieu tab)
		local side = new("ScrollingFrame", {
			Name = "Sidebar",
			Position = UDim2.new(0, 0, 0, 48),
			Size = UDim2.new(0, 163, 1, -48),
			BackgroundColor3 = Theme.Side,
			BorderSizePixel = 0,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Off,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, main)
		new("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		}, side)
		new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, side)

		local content = new("Frame", {
			Name = "Content",
			Position = UDim2.new(0, 163, 0, 48),
			Size = UDim2.new(1, -163, 1, -48),
			BackgroundColor3 = Theme.Content,
			BorderSizePixel = 0,
		}, main)

		-- nut mo/dong cho dien thoai
		if UIS.TouchEnabled and not UIS.KeyboardEnabled then
			local g2 = new("ScreenGui", { Name = "KhangHubToggle", ResetOnSpawn = false, DisplayOrder = 51 }, CoreGui)
			local b2 = new("TextButton", {
				Size = UDim2.new(0, 46, 0, 46),
				Position = UDim2.new(0, 12, 0.4, 0),
				BackgroundColor3 = Theme.Window,
				Text = "KH",
				TextColor3 = Theme.Title,
				Font = Theme.FontB,
				TextSize = 16,
			}, g2)
			corner(b2, 10)
			b2.MouseButton1Click:Connect(function()
				gui.Enabled = not gui.Enabled
			end)
		end

		local Window = {}
		local pages = {}
		local current

		local function selectPage(p)
			if current == p then
				return
			end
			if current then
				current.sc.Visible = false
				tween(current.btn, { BackgroundTransparency = 1, TextColor3 = Theme.Sub })
			end
			current = p
			p.sc.Visible = true
			tween(p.btn, { BackgroundTransparency = 0, TextColor3 = Color3.new(1, 1, 1) })
		end

		function Window.CreatePage(pcfg)
			pcfg = pcfg or {}
			local pageName = tostring(pcfg.Page_Name or pcfg.Page_Title or "Page")
			local btn = new("TextButton", {
				Name = pageName,
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = pageName,
				TextColor3 = Theme.Sub,
				TextSize = 13,
				Font = Theme.Font,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = #pages + 1,
			}, side)
			corner(btn, 6)

			local sc = new("ScrollingFrame", {
				Name = pageName,
				Visible = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 1, 0),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = Theme.Off,
			}, content)
			new("UIPadding", {
				PaddingTop = UDim.new(0, 12),
				PaddingBottom = UDim.new(0, 12),
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 14),
			}, sc)
			new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, sc)

			local pg = { btn = btn, sc = sc }
			pages[#pages + 1] = pg
			btn.MouseButton1Click:Connect(function()
				selectPage(pg)
			end)
			btn.MouseEnter:Connect(function()
				if current ~= pg then
					btn.TextColor3 = Theme.Text
				end
			end)
			btn.MouseLeave:Connect(function()
				if current ~= pg then
					btn.TextColor3 = Theme.Sub
				end
			end)
			if not current then
				selectPage(pg)
			end

			local Page = {}
			local secCount = 0

			function Page.CreateSection(title)
				secCount = secCount + 1
				local secTitle = tostring(title or "Section")
				local box = new("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = secCount,
				}, sc)
				new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, box)
				local hdr = label(box, string.upper(secTitle), 12, Theme.Title, Theme.FontB)
				hdr.Size = UDim2.new(1, 0, 0, 22)
				hdr.LayoutOrder = 0

				local S = {}
				local n = 0
				local function nextOrder()
					n = n + 1
					return n
				end

				local function makeRow(minH)
					local r = new("Frame", {
						Size = UDim2.new(1, 0, 0, minH or 42),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundColor3 = Theme.Row,
						BorderSizePixel = 0,
						LayoutOrder = nextOrder(),
					}, box)
					corner(r, 6)
					return r
				end

				local function textBlock(row, title2, desc, rightPad)
					local holder = new("Frame", {
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 0),
						AutomaticSize = Enum.AutomaticSize.Y,
					}, row)
					new("UIPadding", {
						PaddingLeft = UDim.new(0, 16),
						PaddingRight = UDim.new(0, rightPad or 16),
						PaddingTop = UDim.new(0, 11),
						PaddingBottom = UDim.new(0, 11),
					}, holder)
					new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, holder)
					local t = label(holder, tostring(title2), 14, Theme.Text)
					t.Size = UDim2.new(1, 0, 0, 0)
					t.AutomaticSize = Enum.AutomaticSize.Y
					t.TextWrapped = true
					t.TextYAlignment = Enum.TextYAlignment.Top
					t.LayoutOrder = 1
					local d
					if desc and desc ~= "" then
						d = label(holder, tostring(desc), 12, Theme.Sub)
						d.Size = UDim2.new(1, 0, 0, 0)
						d.AutomaticSize = Enum.AutomaticSize.Y
						d.TextWrapped = true
						d.TextYAlignment = Enum.TextYAlignment.Top
						d.LayoutOrder = 2
					end
					return t, d
				end

				local function register(title2, typ, obj, extra)
					local o = { type = typ, Page_Name = pageName, Section_Name = secTitle, FunctionCreate = obj }
					for k, v in pairs(extra or {}) do
						o[k] = v
					end
					Lib.Options[title2] = o
					return o
				end

				------------------------------------------------ Label
				function S.CreateLabel(cfg)
					cfg = type(cfg) == "table" and cfg or { Title = cfg }
					local r = makeRow(36)
					local t = textBlock(r, cfg.Title or "", nil, 16)
					t.TextColor3 = Theme.Sub
					local obj = { __k = true }
					obj.SetText = function(a, b)
						local txt = isSelf(a) and b or a
						t.Text = tostring(txt)
					end
					obj.GetText = function()
						return t.Text
					end
					register(tostring(cfg.Title or ""), "textlabel", obj, { text = cfg.Title })
					return obj
				end

				------------------------------------------------ Button
				function S.CreateButton(cfg, cb)
					cfg = type(cfg) == "table" and cfg or { Title = cfg }
					local title2 = tostring(cfg.Title or "Button")
					local r = makeRow(42)
					textBlock(r, title2, cfg.Desc, 40)
					local arrow = label(r, ">", 14, Theme.Sub, Theme.FontB, Enum.TextXAlignment.Right)
					arrow.Position = UDim2.new(1, -34, 0.5, -10)
					arrow.Size = UDim2.new(0, 20, 0, 20)
					local hit = new("TextButton", {
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 1, 0),
						Text = "",
						AutoButtonColor = false,
						ZIndex = 2,
					}, r)
					hit.MouseEnter:Connect(function()
						tween(r, { BackgroundColor3 = Theme.RowHover })
					end)
					hit.MouseLeave:Connect(function()
						tween(r, { BackgroundColor3 = Theme.Row })
					end)
					hit.MouseButton1Click:Connect(function()
						tween(r, { BackgroundColor3 = Theme.Accent }, 0.08)
						task.delay(0.12, function()
							tween(r, { BackgroundColor3 = Theme.RowHover })
						end)
						if cb then
							task.spawn(cb)
						end
					end)
					local obj = { __k = true }
					register(title2, "button", obj, { value = title2, text = title2 })
					return obj
				end

				------------------------------------------------ Toggle
				function S.CreateToggle(cfg, cb)
					cfg = cfg or {}
					local title2 = tostring(cfg.Title or "Toggle")
					local r = makeRow(42)
					textBlock(r, title2, cfg.Desc, 74)
					local sw = new("Frame", {
						Position = UDim2.new(1, -58, 0.5, -11),
						Size = UDim2.new(0, 42, 0, 22),
						BackgroundColor3 = Theme.Off,
						BorderSizePixel = 0,
					}, r)
					corner(sw, 11)
					local knob = new("Frame", {
						Position = UDim2.new(0, 3, 0.5, -8),
						Size = UDim2.new(0, 16, 0, 16),
						BackgroundColor3 = Color3.new(1, 1, 1),
						BorderSizePixel = 0,
					}, sw)
					corner(knob, 8)
					local obj = { __k = true }
					local opt = register(title2, "toggle", obj, { value = false })
					local state = false
					local function set(v, fire)
						v = v and true or false
						state = v
						opt.value = v
						tween(sw, { BackgroundColor3 = v and Theme.Accent or Theme.Off })
						tween(knob, { Position = v and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) })
						if fire and cb then
							task.spawn(cb, v)
						end
					end
					local hit = new("TextButton", {
						BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 1, 0),
						Text = "",
						ZIndex = 2,
					}, r)
					hit.MouseButton1Click:Connect(function()
						set(not state, true)
					end)
					obj.SetStage = function(a, b)
						if isSelf(a) then
							a = b
						end
						set(a, true)
					end
					obj.SetValue = obj.SetStage
					obj.GetValue = function()
						return state
					end
					if cfg.Default then
						set(true, true)
					end
					return obj
				end

				------------------------------------------------ Slider
				function S.CreateSlider(cfg, cb)
					cfg = cfg or {}
					local title2 = tostring(cfg.Title or "Slider")
					local min, max = tonumber(cfg.Min) or 0, tonumber(cfg.Max) or 100
					local def = tonumber(cfg.Default) or min
					local decimals = (def % 1 ~= 0) or (title2:lower():find("delay", 1, true) ~= nil)
					local r = makeRow(60)
					local obj = { __k = true }
					local opt = register(title2, "slider", obj, { min = min, max = max, step = 1, value = def })
					local w = sliderWidget(r, title2, min, max, def, decimals, function(x)
						opt.value = x
						if cb then
							cb(x)
						end
					end)
					obj.SetValue = function(a, b)
						if isSelf(a) then
