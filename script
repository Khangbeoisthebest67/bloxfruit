			fl = Instance.new("BodyVelocity")
			fl.Name = "KhangFloat"
			fl.Velocity = Vector3.zero
			fl.MaxForce = Vector3.new(100000, 100000, 100000)
			fl.P = 10000
			fl.Parent = r
		end
		if not CS:HasTag(lp, "Teleporting") then
			CS:AddTag(lp, "Teleporting")
		end
		tagUntil = os.clock() + 1.5
		local pos = r.Position
		local diff = tgt.Position - pos
		local dist = diff.Magnitude
		local step = (Settings.Speed or 300) * dt
		if dist <= step or dist < 1 then
			r.CFrame = CFrame.new(tgt.Position) * r.CFrame.Rotation
		else
			r.CFrame = CFrame.new(pos + diff.Unit * step) * r.CFrame.Rotation
		end
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
	elseif fl then
		fl:Destroy()
	end
end))

