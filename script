							Size = UDim2.new(1, -16, 0, 28),
							BackgroundColor3 = Theme.Off,
							PlaceholderText = "Search...",
							PlaceholderColor3 = Theme.Sub,
							Text = "",
							TextColor3 = Theme.Text,
							TextSize = 13,
							Font = Theme.Font,
							ClearTextOnFocus = false,
						}, frame)
						corner(search, 5)
					end
					local list = new("ScrollingFrame", {
						Position = UDim2.new(0, 8, 0, 46 + searchH),
						Size = UDim2.new(1, -16, 1, -(52 + searchH)),
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						ScrollBarThickness = 3,
						ScrollBarImageColor3 = Theme.Off,
						CanvasSize = UDim2.new(0, 0, 0, 0),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
					}, frame)
					local layout = new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)

					local open = false
					local function resize()
						local h = 42
						if open then
							h = 46 + searchH + math.min(layout.AbsoluteContentSize.Y + 8, 190)
						end
						tween(frame, { Size = UDim2.new(1, 0, 0, h) }, 0.15)
					end
					layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
						if open then
							resize()
						end
					end)
					head.MouseButton1Click:Connect(function()
						open = not open
						resize()
					end)

					local obj = { __k = true }
					local opt = register(title2, mode == "single" and "dropdown" or (mode == "multi" and "multi_toggle")
						or (mode == "priority" and "priority_dropdown") or "slider_dropdown", obj, { list = {}, value = nil })

					local items = {}
					local value -- single
					local selected = {} -- multi: name -> bool | priority: mang co thu tu

					local function refreshHeader()
						if mode == "single" then
							sel.Text = value ~= nil and tostring(value) or "Select"
							opt.value = value
						elseif mode == "multi" then
							local c = 0
							for _, v in pairs(selected) do
								if v then
									c = c + 1
								end
							end
							sel.Text = c .. " selected"
							opt.value = selected
						elseif mode == "priority" then
							sel.Text = #selected .. " selected"
							opt.value = selected
						else
							sel.Text = ""
						end
					end

					local function repaint()
						for _, it in ipairs(items) do
							local on = false
							if mode == "single" then
								on = value == it.name
							elseif mode == "multi" then
								on = selected[it.name] == true
							elseif mode == "priority" then
								local idx = table.find(selected, it.name)
								on = idx ~= nil
								it.btn.Text = idx and (idx .. ". " .. it.name) or it.name
							end
							if it.btn:IsA("TextButton") then
								it.btn.BackgroundColor3 = on and Theme.Accent or Theme.Off
								it.btn.BackgroundTransparency = on and 0.45 or 0.4
							end
						end
					end

					local function clear()
						for _, c in ipairs(list:GetChildren()) do
							if c:IsA("TextButton") or c:IsA("Frame") then
								c:Destroy()
							end
						end
						items = {}
					end

					local function sortAlpha(names)
						table.sort(names, function(a, b)
							return a:lower() < b:lower()
						end)
					end

					local ORDER = "ZXCVFB"
					local function sortKeys(names)
						local allSingle = true
						for _, nm in ipairs(names) do
							if #nm ~= 1 or not ORDER:find(nm, 1, true) then
								allSingle = false
							end
						end
						if allSingle then
							table.sort(names, function(a, b)
								return ORDER:find(a, 1, true) < ORDER:find(b, 1, true)
							end)
						else
							sortAlpha(names)
						end
					end

					local function build(data)
						clear()
						data = type(data) == "table" and data or {}
						opt.list = data
						local names = {}
						if mode == "multi" then
							if #data > 0 then
								for _, nm in ipairs(data) do
									nm = tostring(nm)
									names[#names + 1] = nm
									if selected[nm] == nil then
										selected[nm] = false
									end
								end
							else
								for nm, v in pairs(data) do
									nm = tostring(nm)
									names[#names + 1] = nm
									selected[nm] = (v == true)
								end
							end
							sortAlpha(names)
						elseif mode == "slider" then
							for nm in pairs(data) do
								names[#names + 1] = tostring(nm)
							end
							sortKeys(names)
						else
							for _, nm in ipairs(data) do
								names[#names + 1] = tostring(nm)
							end
						end

						for i, nm in ipairs(names) do
							if mode == "slider" then
								local item = data[nm] or data[tonumber(nm)] or {}
								local rowF = new("Frame", {
									Size = UDim2.new(1, -4, 0, 58),
									BackgroundColor3 = Theme.Off,
									BackgroundTransparency = 0.4,
									BorderSizePixel = 0,
									LayoutOrder = i,
								}, list)
								corner(rowF, 5)
								local mn, mx = tonumber(item.Min) or 0, tonumber(item.Max) or 5
								local df = tonumber(item.Default) or mn
								sliderWidget(rowF, tostring(item.Title or nm), mn, mx, df, (df % 1 ~= 0) or mx <= 5, function(x)
									item.Default = x
									if cb then
										cb(item.KeyName or nm, item)
									end
								end)
								items[#items + 1] = { name = nm, btn = rowF }
							else
								local b = new("TextButton", {
									Size = UDim2.new(1, -4, 0, 28),
									BackgroundColor3 = Theme.Off,
									BackgroundTransparency = 0.4,
									AutoButtonColor = false,
									Text = nm,
									TextColor3 = Theme.Text,
									TextSize = 13,
									Font = Theme.Font,
									TextTruncate = Enum.TextTruncate.AtEnd,
									LayoutOrder = i,
								}, list)
								corner(b, 5)
								items[#items + 1] = { name = nm, btn = b }
								b.MouseButton1Click:Connect(function()
									if mode == "single" then
										value = nm
										repaint()
										refreshHeader()
										open = false
										resize()
										if cb then
											task.spawn(cb, nm)
										end
									elseif mode == "multi" then
										selected[nm] = not selected[nm]
										repaint()
										refreshHeader()
										if cb then
											task.spawn(cb, nm, selected[nm])
										end
									else -- priority
										local idx = table.find(selected, nm)
										if idx then
											table.remove(selected, idx)
										else
											selected[#selected + 1] = nm
										end
										repaint()
										refreshHeader()
										if cb then
											task.spawn(cb, table.clone(selected))
										end
									end
								end)
							end
						end
						repaint()
						refreshHeader()
						if search then
							search.Text = ""
						end
					end

					if search then
						search:GetPropertyChangedSignal("Text"):Connect(function()
							local q = search.Text:lower()
							for _, it in ipairs(items) do
								it.btn.Visible = q == "" or it.name:lower():find(q, 1, true) ~= nil
							end
						end)
					end

					-- gia tri mac dinh
					if mode == "single" then
						if cfg.Default ~= nil and type(cfg.Default) ~= "table" then
							value = tostring(cfg.Default)
						end
					elseif mode == "multi" then
						if type(cfg.Default) == "table" then
							for k, v in pairs(cfg.Default) do
								if v == true then
									selected[tostring(k)] = true
								end
							end
						end
					elseif mode == "priority" then
						if type(cfg.Default) == "table" then
							for _, v in ipairs(cfg.Default) do
								selected[#selected + 1] = tostring(v)
							end
						end
					end
					build(cfg.List)

					obj.GetNewList = function(a, b)
						build(isSelf(a) and b or a)
					end
					obj.SetList = obj.GetNewList
					obj.SetValue = function(a, b)
						local v = isSelf(a) and b or a
						if mode == "single" then
							if v ~= nil then
								value = tostring(v)
								repaint()
								refreshHeader()
								if cb then
									task.spawn(cb, value)
								end
							end
						elseif mode == "multi" and type(v) == "table" then
							for k, st in pairs(v) do
								selected[tostring(k)] = (st == true)
							end
							repaint()
							refreshHeader()
						elseif mode == "priority" and type(v) == "table" then
							selected = {}
							for _, nm in ipairs(v) do
								selected[#selected + 1] = tostring(nm)
							end
							repaint()
							refreshHeader()
						end
					end
					return obj
				end

				return S
			end

			return Page
		end

		return Window
	end

	return Lib
end)()

