-- ===== Raid
do
	local raidNames = {}
	pcall(function()
		for _, set in pairs(require(RS.Raids)) do
			for name in pairs(set) do
				raidNames[#raidNames + 1] = name
			end
		end
	end)
	table.sort(raidNames)
	if #raidNames == 0 then
		raidNames = { "Flame", "Ice", "Quake", "Light", "Dark", "String", "Rumble", "Magma", "Human: Buddha", "Sand", "Bird: Phoenix", "Dough" }
	end
	local function raidButton()
		local m = workspace:FindFirstChild("Map")
		if not m then
			return nil
		end
		local ok, b = pcall(function()
			if seaIdx == 2 then
				return m.CircleIsland.RaidSummon2.Button.Main
			elseif seaIdx == 3 then
				return m["Boat Castle"].RaidSummon2.Button.Main
			end
		end)
		return ok and b or nil
	end
	local function lastIsland()
		local wo = workspace:FindFirstChild("_WorldOrigin")
		local loc = wo and wo:FindFirstChild("Locations")
		local r = hrp()
		local best, bn = nil, 0
		if loc and r then
			for _, l in ipairs(loc:GetChildren()) do
				if l.Name:find("Island ") and (l.Position - r.Position).Magnitude < 3000 then
					local n = tonumber((l.Name:gsub("Island ", ""))) or 0
					if n > bn then
						best, bn = l, n
					end
				end
			end
		end
		return best
	end
	local function inRaid()
		local ok, vis = pcall(function()
			return lp.PlayerGui.Main.TopHUDList.RaidTimer.Visible
		end)
		return ok and vis and lastIsland() ~= nil
	end
	local function hasTool(name)
		return lp.Backpack:FindFirstChild(name) or (lp.Character and lp.Character:FindFirstChild(name))
	end
	local lastClick, lastBuy = 0, 0
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.AutoRaid and seaIdx ~= 1
		end,
		tick = function()
			if inRaid() then
				local mob = nearestAnyMob(400)
				if mob then
					fight(mob, true)
				else
					local isl = lastIsland()
					if isl then
						move(isl.CFrame * CFrame.new(0, 60, 0))
						status("Raid: moving to next island")
					end
				end
				return true
			end
			if hasTool("Special Microchip") then
				local btn = raidButton()
				if btn and btn:FindFirstChild("ClickDetector") then
					stopMove()
					if os.clock() - lastClick > 3 and fireclickdetector then
						lastClick = os.clock()
						fireclickdetector(btn.ClickDetector)
						status("Starting raid")
					end
				else
					move(seaIdx == 3 and CFrame.new(-5500, 314, -2855) or CFrame.new(-6503, 251, -4495))
					status("Going to raid altar")
				end
				return true
			end
			if os.clock() - lastBuy > 3 then
				lastBuy = os.clock()
				CF("RaidsNpc", "Check")
				CF("RaidsNpc", "Select", Settings.Raid or "Flame")
				status("Buying raid chip (hold a fruit)")
			end
			return true
		end,
	}
	UIQ[#UIQ + 1] = function(Main, ctx)
		local P = Main.CreatePage({ Page_Name = "Raid", Page_Title = "Raid" })
		local S = P.CreateSection("Auto Raid")
		S.CreateDropdown({ Title = "Select Raid", List = raidNames, Search = true, Default = Settings.Raid }, bind("Raid"))
		S.CreateToggle({ Title = "Auto Raid", Desc = "Can cam 1 trai trong tui de mua chip. Chi Sea 2 / Sea 3", Default = Settings.AutoRaid }, bind("AutoRaid"))
	end
end

