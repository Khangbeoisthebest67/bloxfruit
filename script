local ignoredChests = {}
local ignoredChestSpawns = {}
local chestTarget, chestSince
local function nearestChest()
	local r = hrp()
	if not r then
		return nil
	end
	local best, bd
	for _, c in ipairs(CS:GetTagged("_ChestTagged")) do
		if
			c:IsA("BasePart")
			and c.Parent
			and not c:GetAttribute("IsDisabled")
			and c:FindFirstChild("TouchInterest")
			and (ignoredChests[c] or 0) < os.clock()
		then
			local d = (c.Position - r.Position).Magnitude
			if not bd or d < bd then
				best, bd = c, d
			end
		end
	end
	return best
end

local function chestTick()
	local r, h = hrp(), hum()
	if not r or not h then
		return false
	end
	if
		not chestTarget
		or not chestTarget.Parent
		or chestTarget:GetAttribute("IsDisabled")
		or not chestTarget:FindFirstChild("TouchInterest")
		or (ignoredChests[chestTarget] or 0) > os.clock()
	then
		chestTarget = nearestChest()
		chestSince = nil
	end
	if chestTarget then
		move(chestTarget.CFrame)
		status("Collecting chest")
		if (r.Position - chestTarget.Position).Magnitude <= 5 then
			chestSince = chestSince or os.clock()
			touch(chestTarget)
			h.Jump = true
			if os.clock() - chestSince >= 5 then
				ignoredChests[chestTarget] = os.clock() + 120
				chestTarget = nil
			end
		else
			chestSince = nil
		end
		return true
	end
	-- chua tai duoc ruong nao: di qua cac diem spawn de tai map
	local wo = workspace:FindFirstChild("_WorldOrigin")
	local ps = wo and wo:FindFirstChild("PlayerSpawns")
	local pirates = ps and ps:FindFirstChild("Pirates")
	if not pirates then
		return false
	end
	local best, bd
	for _, m in ipairs(pirates:GetChildren()) do
		local part = m:IsA("Model") and m:FindFirstChild("Part")
		if part and (ignoredChestSpawns[m] or 0) < os.clock() then
			local d = (part.Position - r.Position).Magnitude
			if not bd or d < bd then
				best, bd = m, d
			end
		end
	end
	if not best then
		ignoredChestSpawns = {}
		return false
	end
	local part = best.Part
	move(part.CFrame)
	status("Searching chests")
	if (r.Position - part.Position).Magnitude <= 100 then
		ignoredChestSpawns[best] = os.clock() + 120
	end
	return true
end

