	local stun = c:FindFirstChild("Stun")
	if stun and stun.Value ~= 0 then
		return
	end
	local hits, seen = {}, {}
	for _, e in ipairs(workspace.Enemies:GetChildren()) do
		local er = e:FindFirstChild("HumanoidRootPart")
		if er and e ~= c then
			local positions = { er.Position }
			if er.Size.Y > 5 then
				table.insert(positions, (er.CFrame * CFrame.new(0, -er.Size.Y * 1.5 + 3, 0)).Position)
			end
			for _, p in ipairs(positions) do
				if (p - r.Position).Magnitude < 10 + range + er.Size.X / 2 then
					for _, part in ipairs(e:GetChildren()) do
						if part:IsA("BasePart") and (part.Position - r.Position).Magnitude <= range + er.Size.X / 2 then
							local rig = CombatUtil:GetRigOfHitPart(part)
							if rig and not seen[rig] and LIMBS[part.Name] and CombatUtil:IsVulnerable(rig) then
								seen[rig] = true
								hits[#hits + 1] = { rig, part }
							end
						end
					end
					break
				end
			end
		end
	end
	if #hits == 0 then
		return
	end
	RegisterAttack:FireServer(0)
	local first = table.remove(hits, 1)
	RegisterHit:FireServer(first[2], hits)
end

local fruitCounter = 1
local function fruitM1(target)
	local c, r = lp.Character, hrp()
	if not c or not r or not target then
		return false
	end
	local tr = target:FindFirstChild("HumanoidRootPart")
	local tool = getTool("Blox Fruit")
	tool = tool and c:FindFirstChild(tool.Name)
	if not tr or not tool then
		return false
	end
	local pos = tr.Position
	local dir = (pos - r.Position).Unit
	local lc = tool:FindFirstChild("LeftClickRemote")
	local rf = tool:FindFirstChild("RemoteFunction")
	local re = tool:FindFirstChild("RemoteEvent")
	if not lc and rf then
		if re then
			re:FireServer(pos)
		end
		task.spawn(function()
			rf:InvokeServer("TAP")
		end)
		return true
	end
	if lc then
		fruitCounter = fruitCounter + 1
		if fruitCounter > 5 then
			fruitCounter = 1
		end
		if tool.Name == "Mammoth-Mammoth" then
			lc:FireServer(pos)
		else
			lc:FireServer(dir, fruitCounter)
		end
		return true
	end
	return false
end

