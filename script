local function findMob(names)
	local r = hrp()
	if not r then
		return nil
	end
	local best, bd
	for _, m in ipairs(workspace.Enemies:GetChildren()) do
		local match = (type(names) == "table" and table.find(names, m.Name)) or m.Name == names
		if match and isAlive(m) then
			local d = (m.HumanoidRootPart.Position - r.Position).Magnitude
			if not bd or d < bd then
				best, bd = m, d
			end
		end
	end
	return best
end

local function nearestAnyMob(maxDist)
	local r = hrp()
	if not r then
		return nil
	end
	local best, bd = nil, maxDist
	for _, m in ipairs(workspace.Enemies:GetChildren()) do
		if isAlive(m) then
			local d = (m.HumanoidRootPart.Position - r.Position).Magnitude
			if d < bd then
				best, bd = m, d
			end
		end
	end
	return best
end

local function noCollide(m)
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and p.CanCollide then
			p.CanCollide = false
		end
	end
end

local function isNetOwner(part)
	local folder = workspace:FindFirstChild("Characters")
	if not folder then
		return true
	end
	for _, c in ipairs(folder:GetChildren()) do
		if c.Name ~= lp.Name and c:FindFirstChild("HumanoidRootPart") then
			if (c.HumanoidRootPart.Position - part.Position).Magnitude <= 300 then
				return false
			end
		end
	end
	return true
end

local function bring(mob)
	local mr = mob:FindFirstChild("HumanoidRootPart")
	local r = hrp()
	if not mr or not r or (r.Position - mr.Position).Magnitude > 50 then
		return
	end
	local center = mr.CFrame
	local count = 1
	local maxCount = Settings.BringCount or 3
	for _, m in ipairs(workspace.Enemies:GetChildren()) do
		if count >= maxCount then
			break
		end
		if m ~= mob and m.Name == mob.Name and isAlive(m) and isNetOwner(m.HumanoidRootPart) then
			if (m.HumanoidRootPart.Position - center.Position).Magnitude <= 250 then
				noCollide(m)
				m.HumanoidRootPart.CFrame = center * CFrame.new(math.random(-2, 2), 0, math.random(-2, 2))
				count = count + 1
			end
		end
	end
end

local function fight(mob, noBring)
	local r = hrp()
	local mr = mob:FindFirstChild("HumanoidRootPart")
	if not r or not mr then
		return
	end
	local dist = (r.Position - mr.Position).Magnitude
	if dist < 60 then
		noCollide(mob)
		if Settings.BringMob and not noBring then
			bring(mob)
		end
	end
	local tip = Settings.Weapon
	local masteryOn = false
	if Settings.FarmMastery then
		local mh = mob:FindFirstChildWhichIsA("Humanoid")
		if mh and mh.MaxHealth > 0 and mh.Health / mh.MaxHealth <= (Settings.MasteryHP or 40) / 100 then
			tip = Settings.MasteryMethod or "Blox Fruit"
			masteryOn = true
		end
	end
	activeTip = tip
	equip()
	local x = (tip == "Blox Fruit") and -7 or 7
	move(mr.CFrame * CFrame.new(x, Settings.Height or 20, 0))
	if dist < 70 then
		local done = tip == "Blox Fruit" and fruitM1(mob)
		if not done then
			pcall(attackAOE, Settings.Range or 30)
		end
	end
	env.KhangAim = mr.CFrame
	env.KhangAimT = os.clock()
	if (Settings.AutoSkill or masteryOn) and dist < 90 and not skillBusy then
		task.spawn(useSkill)
	end
	status("Fighting " .. mob.Name)
end

-- tim khu spawn khi chua thay quai
local ignoredSpawns = {}
local currentSpawn, arrivedAt
local function goSpawn(names)
	local list = type(names) == "table" and names or { names }
	local wo = workspace:FindFirstChild("_WorldOrigin")
	local spawns = wo and wo:FindFirstChild("EnemySpawns")
	local r = hrp()
	if not spawns or not r then
		status("Waiting spawn data")
		return
	end
	if currentSpawn and (not currentSpawn.Parent or (ignoredSpawns[currentSpawn] or 0) > os.clock()) then
		currentSpawn, arrivedAt = nil, nil
	end
	if not currentSpawn then
		local best, bd
		for _, p in ipairs(spawns:GetChildren()) do
			if p:IsA("BasePart") and (ignoredSpawns[p] or 0) < os.clock() then
				if table.find(list, stripLv(p.Name)) or table.find(list, p.Name) then
					local d = (p.Position - r.Position).Magnitude
					if not bd or d < bd then
						best, bd = p, d
					end
				end
			end
		end
		currentSpawn = best
		arrivedAt = nil
	end
	if not currentSpawn then
		stopMove()
		status("No spawn found for " .. tostring(list[1]) .. " (wrong sea?)")
		return
	end
	local goal = currentSpawn.CFrame * CFrame.new(0, 60, 0)
	move(goal)
	status("Searching " .. tostring(list[1]))
	if (r.Position - goal.Position).Magnitude < 20 then
		arrivedAt = arrivedAt or os.clock()
		if os.clock() - arrivedAt > 2 then
			ignoredSpawns[currentSpawn] = os.clock() + 15
			currentSpawn, arrivedAt = nil, nil
		end
	end
end

