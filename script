					Settings.CollectFruit = Settings.KtFruit == true
					local picked = false
					for _, on in pairs(Settings.Stats) do
						if on then
							picked = true
						end
					end
					if not picked then
						Settings.Stats.Melee = true
						Settings.Stats.Defense = true
					end
					Settings.Mode = ktMode(lvl)

					local world = Settings.KtWorld ~= false
					Settings.AutoNewWorld = world and seaIdx == 1 and lvl >= 700
					KT.Third = world and seaIdx == 2 and lvl >= 1500
					KT.Saber = Settings.KtSaber ~= false and seaIdx == 1 and lvl >= 200 and not owns("Saber")
					KT.Yama = Settings.KtYama == true and seaIdx == 3 and not owns("Yama")
					KT.Tushita = Settings.KtTushita == true and seaIdx == 3 and not owns("Tushita")
					KT.Rainbow = Settings.KtRainbow == true and seaIdx == 3 and lvl >= 1100

					if os.clock() - lastBuy > 60 then
						lastBuy = os.clock()
						CF("BuyHaki", "Geppo")
						CF("BuyHaki", "Buso")
						CF("BuyHaki", "Soru")
						CF("KenTalk", "Buy")
					end
					if ktLabel then
						ktLabel.SetText(string.format("Kaitun: level %d | sea %d | mode %s", lvl, seaIdx, Settings.Mode))
					end
				end)
			else
				KT.Saber, KT.Yama, KT.Tushita, KT.Rainbow, KT.Third = nil, nil, nil, nil, nil
			end
		end
	end)

	UIQ[#UIQ + 1] = function(Main, ctx)
		local K = Main.CreatePage({ Page_Name = "Kaitun", Page_Title = "Kaitun" })
		local S0 = K.CreateSection("Kaitun (Full Auto)")
		ktLabel = S0.CreateLabel({ Title = "Kaitun: off" })
		S0.CreateToggle({
			Title = "Enable Kaitun",
			Desc = "Tu dong: farm level, chon che do theo level, sang Sea 2/3, lam quest vat pham, cong diem, cat trai",
			Default = Settings.Kaitun,
		}, function(v)
			Settings.Kaitun = v
			if not v then
				Settings.StartFarm = false
				stopMove()
			end
			save()
		end)
		local S1 = K.CreateSection("Kaitun Options")
		S1.CreateToggle({ Title = "Auto Change Sea (700 / 1500)", Default = Settings.KtWorld ~= false }, bind("KtWorld"))
		S1.CreateToggle({ Title = "Get Saber (Sea 1)", Default = Settings.KtSaber ~= false }, bind("KtSaber"))
		S1.CreateToggle({ Title = "Get Yama (Sea 3)", Default = Settings.KtYama }, bind("KtYama"))
		S1.CreateToggle({ Title = "Get Tushita (Sea 3)", Default = Settings.KtTushita }, bind("KtTushita"))
		S1.CreateToggle({ Title = "Get Rainbow Haki (Sea 3)", Default = Settings.KtRainbow }, bind("KtRainbow"))
		S1.CreateToggle({ Title = "Collect Fruit While Farming", Default = Settings.KtFruit }, bind("KtFruit"))
		local S2 = K.CreateSection("Item Quests (manual)")
		S2.CreateToggle({ Title = "Auto Saber", Desc = "Sea 1, level 200+", Default = Settings.AutoSaber }, bind("AutoSaber"))
		S2.CreateToggle({ Title = "Auto Yama", Desc = "30 Elite Hunter roi rut kiem", Default = Settings.AutoYama }, bind("AutoYama"))
