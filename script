local safe, safeTarget = false, nil
local function farmTick()
	local r, h = hrp(), hum()
	if not r or not h or h.Health <= 0 then
		stopMove()
		status("Waiting respawn...")
		task.wait(0.5)
		return
	end
	if h.Sit then
		h.Jump = true
		task.wait(0.2)
		return
	end

	if Settings.SafeHP then
		local ratio = h.Health / h.MaxHealth
		if not safe and ratio < (Settings.SafePercent or 30) / 100 then
			safe = true
			safeTarget = CFrame.new(r.Position + Vector3.new(0, 800, 0))
		end
		if safe and ratio > 0.8 then
			safe = false
		end
		if safe then
			move(safeTarget)
			status("Low HP - resting in the sky")
			return
		end
	else
		safe = false
	end

	if Settings.TeleIsland then
		local pos = ISLANDS[Settings.Island]
		if pos then
			move(CFrame.new(pos))
			status("Teleporting to " .. tostring(Settings.Island))
			if (r.Position - pos).Magnitude < 15 then
				stopMove()
				A.CreateNoti({ Title = "Teleport", Desc = "Arrived: " .. tostring(Settings.Island), ShowTime = 3 })
				if teleIslandToggle then
					teleIslandToggle:SetStage(false)
				else
					Settings.TeleIsland = false
				end
			end
			return
		else
			Settings.TeleIsland = false
		end
	end

	if Settings.CollectFruit then
		local f = findFruit()
		if f then
			collectFruit(f)
			return
		end
	end
	if Settings.AutoChest then
		if chestTick() then
			return
		end
	end

	for _, ex in ipairs(Extras) do
		if ex.enabled() then
			local ok, handled = pcall(ex.tick)
			if ok and handled then
				return
			end
		end
	end

	if Settings.AutoElite then
		local e = findElite()
		if e then
			if ensureElite(e.Name) then
				fight(e, true)
			end
			return
		end
	end

	if Settings.KillBoss and Settings.Boss then
		local boss = findBoss(Settings.Boss)
		if boss then
			fight(boss, true)
			return
		end
	end

	if not Settings.StartFarm then
		stopMove()
		status(Settings.KillBoss and ("Waiting boss: " .. tostring(Settings.Boss)) or "Waiting fruit / chest")
		return
	end

	local mode = Settings.Mode
	if mode == "Level Farm" then
		levelFarmTick()
	elseif MODES[mode] then
		modeTick(MODES[mode])
	else -- Nearest Mob
		local m = nearestAnyMob(1500)
		if m then
			fight(m)
		else
			stopMove()
			status("No mobs nearby")
		end
	end
end

