-- ===== Stack farm: boss, summon, factory, raid dao, new world, law
do
	local function tool(name)
		return lp.Backpack:FindFirstChild(name) or (lp.Character and lp.Character:FindFirstChild(name))
	end
	local function equipNamed(name)
		local t = lp.Backpack:FindFirstChild(name)
		local h = hum()
		if t and h then
			h:EquipTool(t)
		end
	end
	local function click(cd)
		if cd and fireclickdetector then
			pcall(fireclickdetector, cd)
		end
	end
	local lastHop = 0

	-- Kill all boss
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.KillAllBoss
		end,
		tick = function()
			for _, name in ipairs(BOSSES) do
				local b = findBoss(name)
				if b then
					fight(b, true)
					return true
				end
			end
			if Settings.HopNoBoss and os.clock() - lastHop > 20 then
				lastHop = os.clock()
				hopServer()
			end
			return false
		end,
	}

	-- hop khi khong co trai
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.CollectFruit and Settings.HopNoFruit
		end,
		tick = function()
			if not findFruit() and os.clock() - lastHop > 15 then
				lastHop = os.clock()
				hopServer()
			end
			return false
		end,
	}

	-- Summon Darkbeard / Soul Reaper (di chuyen), Dough King (remote)
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.SummonDarkbeard or Settings.SummonSoulReaper
		end,
		tick = function()
			local r = hrp()
			if not r then
				return false
			end
			if Settings.SummonDarkbeard and tool("Fist of Darkness") then
				local det
				pcall(function()
					det = workspace.Map.DarkbeardArena.Summoner.Detection
				end)
				if det then
					move(det.CFrame)
					status("Summoning Darkbeard")
					if (r.Position - det.Position).Magnitude <= 6 then
						equipNamed("Fist of Darkness")
						local t = tool("Fist of Darkness")
						if t and t:FindFirstChild("Handle") and firetouchinterest then
							pcall(firetouchinterest, t.Handle, det, 0)
							pcall(firetouchinterest, t.Handle, det, 1)
							pcall(firetouchinterest, r, det, 0)
							pcall(firetouchinterest, r, det, 1)
						end
					end
					return true
				end
			end
			if Settings.SummonSoulReaper and tool("Hallow Essence") then
				local det
				pcall(function()
					det = workspace.Map["Haunted Castle"].Summoner.Detection
				end)
				if det then
					move(det.CFrame)
					status("Summoning Soul Reaper")
					if (r.Position - det.Position).Magnitude <= 8 then
						equipNamed("Hallow Essence")
					end
					return true
				end
			end
			return false
		end,
	}
	task.spawn(function()
		while alive() do
			task.wait(1)
			if Settings.SummonDough and tool("Sweet Chalice") then
				CF("CakePrinceSpawner")
			end
		end
	end)

	-- Auto Factory (Core)
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.AutoFactory
		end,
		tick = function()
			local core = findBoss("Core")
			if core then
				fight(core, true)
				return true
			end
			return false
		end,
	}

	-- Pirate Raid (Sea 3)
	local function pirateMob()
		local center = Vector3.new(-5543, 313, -2964)
		for _, cont in ipairs({ workspace.Enemies, RS }) do
			for _, m in ipairs(cont:GetChildren()) do
				if
					m:IsA("Model")
					and m.Name ~= "Oni2"
					and m.Name ~= "rip_indra True Form"
					and not m.Name:find("Boss")
					and not m.Name:find("Friend")
					and not m.Name:find("Wraith")
					and isAlive(m)
					and (m.HumanoidRootPart.Position - center).Magnitude < 1000
				then
					return m
				end
			end
		end
	end
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.AutoPirateRaid and seaIdx == 3
		end,
		tick = function()
			local m = pirateMob()
			if m then
				fight(m, true)
				return true
			end
			return false
		end,
	}

	-- Auto New World (Sea 1, level >= 700)
	Extras[#Extras + 1] = {
		enabled = function()
			return Settings.AutoNewWorld and seaIdx == 1
		end,
		tick = function()
			if lp.Data.Level.Value < 700 then
				status("New World needs level 700")
				return false
			end
			if CF("DressrosaQuestProgress", "Dressrosa") == 0 then
				status("Travelling to New World")
				CF("TravelDressrosa")
				task.wait(2)
				return true
			end
			local r = hrp()
			local door
			pcall(function()
