local function readText(inst)
	if not inst then
		return nil
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		return inst.Text ~= "" and inst.Text or nil
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("TextLabel") and d.Text ~= "" then
			return d.Text
		end
	end
	return nil
end
local function questTitle()
	local pg = lp:FindFirstChild("PlayerGui")
	if not pg then
		return nil
	end
	local main = pg:FindFirstChild("Main") or pg:FindFirstChild("Main (minimal)")
	local q = main and main:FindFirstChild("Quest")
	if q and q.Visible then
		local cont = q:FindFirstChild("Container")
		local qt = cont and cont:FindFirstChild("QuestTitle")
		local txt = readText(qt and qt:FindFirstChild("Title"))
		if txt then
			return txt
		end
	end
	local tr = pg:FindFirstChild("TrackedQuestFrame")
	if tr then
		local on = (tr:IsA("ScreenGui") and tr.Enabled) or (tr:IsA("GuiObject") and tr.Visible)
		local fr = tr:FindFirstChild("Frame")
		if on and fr and fr.Visible then
			return readText(fr:FindFirstChild("header"))
		end
	end
	return nil
end
local seenUntil = 0
local function hasQuest()
	if questTitle() ~= nil then
		seenUntil = tick() + 1
		return true
	end
	return tick() < seenUntil
end

local EXCLUDED = { BartiloQuest = true, Trainees = true, MarineQuest = true, CitizenQuest = true }
local function bestQuest(level)
	if not (Quests and GuideModule and GuideModule.Data and GuideModule.Data.NPCList) then
		return nil
	end
	local best, bl = nil, 0
	pcall(function()
		for _, r in pairs(GuideModule.Data.NPCList) do
			if not EXCLUDED[r.InternalQuestName] then
				local set = Quests[r.InternalQuestName]
				for idx, req in pairs(r.Levels) do
					local q = set and set[idx]
					if q then
						local mob, cnt = next(q.Task)
						if cnt and cnt > 1 and req <= level and req >= bl then
							bl = req
							best = {
								Level = req,
								Name = r.NPCName,
								QuestName = r.InternalQuestName,
								Pos = r.Position,
								Id = idx,
								Mob = mob,
							}
						end
					end
				end
			end
		end
	end)
	return best
end

local function currentQuestMob()
	local d = GuideModule and GuideModule.Data
	local qd = d and d.QuestData
	if qd and qd.Task then
		for name in pairs(qd.Task) do
			return name
		end
	end
	return nil
end

local questPointCache
local function questPoint(name)
	if not questPointCache then
		questPointCache = {}
		pcall(function()
			local byLevel = {}
			for qn, set in pairs(Quests) do
				if qn ~= "MarineQuest" then
					for _, q in pairs(set) do
						byLevel[q.LevelReq] = qn
					end
				end
			end
			for _, r in pairs(GuideModule.Data.NPCList) do
				for _, lv in pairs(r.Levels) do
					local qn = byLevel[lv]
					if qn and not questPointCache[qn] then
						questPointCache[qn] = CFrame.new(r.Position)
					end
				end
			end
		end)
	end
	return questPointCache[name]
end

local function takeQuest(pos, qname, id)
	local r = hrp()
	if not r then
		return
	end
	move(CFrame.new(pos) * CFrame.new(0, 4, 2))
	if (r.Position - pos).Magnitude <= 8 then
		status("Taking quest")
		task.wait(0.5)
		CF("StartQuest", qname, id)
		task.wait(1)
	else
		status("Going to quest NPC")
	end
end

